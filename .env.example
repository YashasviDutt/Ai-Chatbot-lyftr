# Comma-separated key pool (at least 2). Ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model name that matches your keys' provider
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
CACHE_TYPE=local
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
# Frontend build-time (set in Vercel/Netlify, or docker compose)
VITE_API_URL=http://localhost:8000
